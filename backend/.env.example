# Server-only configuration. Do not commit a real .env file.
MONGO_URL=
DB_NAME=
JWT_SECRET=
QA_CLEANUP_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kalqlater.com,https://www.kalqlater.com
# Reserved for frontend-origin links; not currently read by server.py.
FRONTEND_URL=
LOCALIZATION_REVIEWER_EMAILS=
# Optional and server-only. Leave LOCALIZATION_AI_PROVIDER blank to keep AI draft
# generation disabled. Never expose these values to the browser.
LOCALIZATION_AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_LOCALIZATION_MODEL=
LOCALIZATION_PROVIDER_TIMEOUT_SECONDS=30
# Resend configuration. CONTACT_FROM_EMAIL must be a verified Resend sender.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=nikhil.s.workz@gmail.com
